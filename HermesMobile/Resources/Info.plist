<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>nAIce uses the camera to scan receipts, business cards, and whiteboards. No photos are stored without your permission.</string>
	<key>NSContactsUsageDescription</key>
	<string>nAIce syncs your contacts to build a relationship CRM. No contacts are shared with third parties.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>nAIce uses Face ID to lock the app and protect your data.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>nAIce reads your health data to provide personalized insights, such as resting heart rate and steps. Your data stays on your device.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>nAIce may write mindfulness minutes to Health.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>nAIce uses HomeKit to control smart home devices, like lights, thermostats, and scenes.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>nAIce uses your location to show relevant context and suggestions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>nAIce uses the microphone for voice dictation in chat. No audio is recorded without your action.</string>
	<key>NSRemindersUsageDescription</key>
	<string>nAIce syncs your reminders to show your daily tasks. No reminders are shared with third parties.</string>
	<key>NSSiriUsageDescription</key>
	<string>nAIce integrates with Siri so you can start new chats and interact with your agent hands-free.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INStartCallIntent</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>pro.naice.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>naice</string>
			</array>
		</dict>
	</array>
</dict>
</plist>